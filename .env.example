# Copie para `.env` e ajuste. O `.env` é ignorado pelo Git: nunca versione chaves.

# Banco de dados. Padrão: SQLite local (sql_app.db), sem configurar nada.
# Para PostgreSQL (por exemplo AWS RDS), instale um driver (`pip install "psycopg[binary]"`)
# e descomente a linha abaixo com os seus dados:
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/banco

# Coleta: navegador sem interface gráfica e limite de páginas por varredura
HEADLESS_BROWSER=True
VARREDURA_MAX_PAGES=5

# LLM para a leitura do edital (opcional). Endpoint compatível com OpenAI.
# Sem chave, a rota de edital responde "não configurado" sem quebrar o app.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash
# Outros provedores:
#   Mistral:    LLM_BASE_URL=https://api.mistral.ai/v1         LLM_MODEL=mistral-small-latest
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1      LLM_MODEL=<modelo>
